# Zero-Trust Sentinel - environment template
#
# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# Real environment variables (hosting platform secrets) always win over this
# file: load_dotenv() does not override what the platform already exported.
# Values below are placeholders, not secrets.

# --- Database (PostgreSQL) --------------------------------------------------
# Required. asyncpg URL.
# Compose default: the bundled `db` service (change POSTGRES_PASSWORD below).
# sslmode=disable is correct for the in-compose database (no TLS inside the
# private compose network); external databases must keep sslmode=require.
DATABASE_URL=postgresql://sentinel:change-me-local-db@db:5432/sentinel?sslmode=disable
# Bare-metal on the same host instead:
#   DATABASE_URL=postgresql://sentinel:change-me-local-db@127.0.0.1:5432/sentinel?sslmode=disable
# External free Postgres (e.g. Neon) - then start only: docker compose up -d api worker
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-local-db

# --- LLM (Groq - existing free-tier analysis engine) ------------------------
# Required for scans and every AI-generated business skill.
# Without it the API still boots, /health reports llm_configured=false, and
# each analysis records an honest "model_unavailable" error.
GROQ_API_KEY=gsk_replace_me
# Optional overrides:
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TPM_LIMIT=7500                 # token bucket per minute; 0 disables
GROQ_CALL_TOKEN_ESTIMATE=1500       # hold per call; settle() trims to actual

# --- Email sending (outbound engine) ---------------------------------------
# The HOLD gate refuses to mail until one provider authenticates the sender.
# Prefer SendGrid when the zone cannot publish Resend TXT DKIM/SPF records.
SENDGRID_API_KEY=                   # optional but preferred
RESEND_API_KEY=                     # optional fallback
FROM_EMAIL=security@zerodaysentinel.xo.je
MAX_EMAILS_PER_DAY=20
JITTER_MIN_SECONDS=60
JITTER_MAX_SECONDS=120
WIN_BACK_JITTER_SECONDS=60

# --- Payments (PayPal is the live path; Stripe optional) --------------------
PAYPAL_MODE=live                    # sandbox | live
PAYPAL_CLIENT_ID=replace_me
PAYPAL_SECRET=replace_me
PAYPAL_PLAN_ID=replace_me
PAYPAL_WEBHOOK_ID=replace_me
PAYPAL_API_BASE=                    # optional explicit override of the mode host
STRIPE_SECRET_KEY=                  # optional
STRIPE_WEBHOOK_SECRET=              # optional
PRICE_ID_MONTHLY=                   # optional
AIRTM_PAYMENT_LINK=                 # optional fallback payment link

# --- API, dashboard and site -----------------------------------------------
SITE_URL=https://zerodaysentinel.xo.je
MELLENTH_ADMIN_TOKEN=replace_with_a_long_random_secret
FRONTEND_ORIGINS=                   # comma list; empty = any origin (public data)
PORT=8000                           # containers listen here; proxy in front

# --- Scanning and analysis limits ------------------------------------------
SCAN_CONCURRENCY=3                  # keep scans inside provider + host limits
BUSINESS_TOOL_TIMEOUT=90            # seconds per vendored founder-skill script
BUSINESS_LLM_TIMEOUT=120            # seconds per business-skill model call
BUSINESS_MAX_INPUT_BYTES=50000
BUSINESS_MAX_CONTEXT_BYTES=50000
BUSINESS_WORK_DIR=                  # default ./business_work

# --- Reverse proxy / domain -------------------------------------------------
# Caddy reads the site URL from here in the compose profile.
CADDY_SITE_URL=https://zerodaysentinel.xo.je
CADDY_UPSTREAM=http://api:8000

# --- Discovery agent (optional; runs only when present) ---------------------
ANTHROPIC_API_KEY=                  # optional - harvey discovery loop
SKIP_HARVEY=1                       # 1 disables harvey without failing the worker
