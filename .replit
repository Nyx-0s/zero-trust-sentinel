# Replit configuration (card-free host for the API + cockpit)
# The Run button starts the API; open a Shell tab for the outbound engine:
#   python outbound_engine.py
# Replit's free tier SLEEP after inactivity - Always On is a paid feature.
# The laptop-side Hunter (python hunter.py) pings the API before each hunt,
# which wakes the instance (cold start ~30-60s).
run = "bash replit_run.sh"
entrypoint = "api.py"
modules = ["web", "python-3.12", "bash"]
hidden = [".config"]

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]

[[ports]]
localPort = 8080
externalPort = 80
