{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sentinel-web": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api:app",
      "functions": {
        "api.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "crons": [
    {
      "path": "/internal/discover?limit=3",
      "schedule": "43 5 * * *"
    },
    {
      "path": "/internal/run-batch",
      "schedule": "17 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "sentinel-web"
      }
    }
  ]
}